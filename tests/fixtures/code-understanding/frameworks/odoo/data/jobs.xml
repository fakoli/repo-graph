<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_job" model="ir.cron">
        <field name="model_id" ref="model_sample_invoice"/>
        <field name="state">code</field>
        <field name="code">model.action_post()</field>
    </record>
    <record id="computed_job" model="ir.cron">
        <field name="model_id" ref="model_sample_computed"/>
        <field name="state">code</field>
        <field name="code" eval="'model.computed_action()'"/>
    </record>
</odoo>
